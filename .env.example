# ============================================================================
# EduNexus Coaching Center Management & Learning Platform - Environment Config
# Copy this file to .env (in root and/or backend/.env) and update secrets.
# NEVER commit real secrets to version control.
# ============================================================================

NODE_ENV=development
PORT=3000
API_PREFIX=api

# --- Database Configuration ---
# For Docker / Production PostgreSQL:
# DATABASE_URL="postgresql://edunexus:edunexus_secret_password@localhost:5432/edunexus_db?schema=public"
# For Zero-Config Local Development (Prisma SQLite Engine):
DATABASE_URL="file:./dev.db"

# --- Authentication & Security ---
JWT_ACCESS_SECRET="replace-with-strong-256-bit-access-secret-key-in-prod"
JWT_REFRESH_SECRET="replace-with-strong-256-bit-refresh-secret-key-in-prod"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
CORS_ORIGIN="http://localhost:4200"

# --- File Storage Abstraction (local | s3 | r2 | gcs | azure) ---
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15
S3_BUCKET="edunexus-assets"
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Email Provider Abstraction (console | smtp | sendgrid) ---
EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@edunexus.edu"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SENDGRID_API_KEY=""
